{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"typography": {
			"fontFamilies": [
				{ "name": "Atkinson Hyperlegible", "slug": "body", "fontFamily": "\"Atkinson Hyperlegible\", system-ui, sans-serif" },
				{ "name": "Schibsted Grotesk", "slug": "display", "fontFamily": "\"Schibsted Grotesk\", system-ui, sans-serif" }
			]
		},
		"layout": { "contentSize": "48rem", "wideSize": "75rem" }
	},
	"styles": {
		"spacing": { "padding": { "top": "0", "bottom": "0", "left": "0", "right": "0" }, "blockGap": "0" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)" }
	}
}
